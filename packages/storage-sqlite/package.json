    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offlinesync/storage": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "uuidv7": "^1.2.1"
  }
