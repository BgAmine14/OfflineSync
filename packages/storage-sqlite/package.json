{
  "name": "@offlinesync/storage-sqlite",
  "version": "0.0.0",
  "description": "SQLite implementation of the StorageAdapter interface",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
