{
  "name": "@offlinesync/react",
  "version": "1.0.0",
  "description": "React hooks for OfflineSync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offlinesync/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/BgAmine14/OfflineSync#readme",
  "keywords": [
    "offline-first",
    "local-first",
    "sync",
    "offline",
    "conflict-resolution",
    "crdt"
  ]
}
