{
  "name": "@offlinesync/electron",
  "version": "0.0.0",
  "description": "Electron IPC bridge for OfflineSync",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offlinesync/core": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=22.0.0"
  },
  "devDependencies": {}
}