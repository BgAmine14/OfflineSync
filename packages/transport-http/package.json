{
    "name": "@offlinesync/transport-http",
    "version": "1.0.1",
    "description": "HTTP transport for OfflineSync sync protocol",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --build",
        "clean": "tsc --build --clean",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@offlinesync/protocol": "workspace:*"
    },
    "devDependencies": {},
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://bgamine14.github.io/OfflineSync/",
    "keywords": [
        "offline-first",
        "local-first",
        "sync",
        "offline",
        "conflict-resolution",
        "crdt"
    ],
    "repository": {
        "url": "https://github.com/BgAmine14/OfflineSync.git",
        "directory": "packages/transport-http",
        "type": "git"
    }
}
