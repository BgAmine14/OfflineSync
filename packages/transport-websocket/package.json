{
  "name": "@offlinesync/transport-websocket",
  "version": "0.0.0",
  "description": "WebSocket transport for real-time OfflineSync sync protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@offlinesync/protocol": "workspace:*",
    "@offlinesync/transport-http": "workspace:*"
  },
  "devDependencies": {}
}
